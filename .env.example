# ==============================================================================
# EX SHARE - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows (PowerShell): Copy-Item .env.example .env
#      Windows (CMD):        copy .env.example .env
#      Linux / macOS:        cp .env.example .env
# 2. Fill in your real configuration secrets and credentials below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & SECURITY
# ------------------------------------------------------------------------------
# In production, generate a secure random 50+ character string.
# Example generator: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-w^01^8=!drxc9o$y08d@4atllv82xqr5ow%)b_z&fyzgt&ehwo

# Set DEBUG=False in production. Never run with DEBUG=True in public environments!
DEBUG=True

# Comma-separated list of hostnames or IP addresses this Django site can serve
ALLOWED_HOSTS=*


# ------------------------------------------------------------------------------
# 2. EMAIL CONFIGURATION (REQUIRED BY SETTINGS.PY)
# ------------------------------------------------------------------------------
# For local development/testing without real SMTP sending, use the console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# For production SMTP delivery (Gmail, AWS SES, SendGrid, Mailgun):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
# For Gmail: Use a 16-character Google "App Password" (NOT your Google account password)
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=EX SHARE <noreply@exshare.com>


# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (REQUIRED BY SETTINGS.PY FOR GOOGLE LOGIN)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ------------------------------------------------------------------------------
# 4. CELERY & REDIS (TASK QUEUES & BACKGROUND PROCESSING)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery async tasks (media processing, bulk export, etc.)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0


# ------------------------------------------------------------------------------
# 5. CONTENT MODERATION (NUDENET AI FILTERING)
# ------------------------------------------------------------------------------
# Toggle AI NSFW/nudity content filtering on photo uploads (True/False)
NUDE_DETECTION_ENABLED=True

# Confidence score threshold between 0.0 and 1.0 (default: 0.45)
NUDE_DETECTION_THRESHOLD=0.45


# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (RAZORPAY SUBSCRIPTIONS & CLIENT ACCESS PASSES)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Webhook Secret configured in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


# ------------------------------------------------------------------------------
# 7. STORAGE & CDN CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Supported providers: 'local' (default), 's3' (AWS), 'r2' (Cloudflare R2), 'oss' (Alibaba Cloud)
STORAGE_PROVIDER=local

# S3 / Cloudflare R2 / Alibaba OSS credentials (required if STORAGE_PROVIDER != 'local')
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=photography-media
STORAGE_REGION=us-east-1

# Custom endpoint URL (required for Cloudflare R2 or MinIO; leave empty for standard AWS S3)
# Example Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Example MinIO: http://localhost:9000
STORAGE_ENDPOINT=

# Optional CDN domain to serve photos and thumbnails (e.g., https://cdn.yourdomain.com)
CDN_BASE_URL=


# ------------------------------------------------------------------------------
# 8. FACIAL RECOGNITION (FACE SEARCH & EMBEDDINGS)
# ------------------------------------------------------------------------------
# Cosine similarity match threshold (0.0 to 1.0, default: 0.65)
FACE_MATCH_THRESHOLD=0.65
