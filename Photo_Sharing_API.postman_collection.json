{
	"info": {
		"_postman_id": "9b1f7c8a-4d2e-4b6a-9123-enterprise-gallery-api",
		"name": "Enterprise Gallery, Face Discovery, & Storage Quota API",
		"description": "Postman Collection for testing production-ready photographer media delivery, client galleries, face search, S3/R2 direct uploads, secure downloads, and subscription storage limits.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
